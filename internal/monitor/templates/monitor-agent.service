[Unit]
Description=abox Monitor Agent
After=tetragon.service
Requires=tetragon.service
ConditionPathExists={{.Device}}

[Service]
Type=simple
ExecStart=/usr/local/bin/abox-monitor-agent
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow={{.Device}} rw
ReadWritePaths={{.DeviceDir}}
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
