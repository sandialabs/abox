<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>abox-{{.Name}}</name>
{{- if .UUID}}
  <uuid>{{.UUID}}</uuid>
{{- end}}
  <memory unit='MiB'>{{.Memory}}</memory>
  <vcpu>{{.CPUs}}</vcpu>
  <iothreads>1</iothreads>
  <memoryBacking>
    <nosharepages/>
  </memoryBacking>
  <os>
    <!-- Pin the q35 machine type explicitly. q35 gives a PCIe topology with
         native AHCI and drops the legacy i440fx PIIX3 southbridge (ISA bridge,
         legacy IDE, ACPI PM) that the default machine type would otherwise pull
         in, trimming the emulated device/parser surface exposed to the guest.
         Pinning also removes the host-dependent "whatever this libvirt/QEMU
         defaults to" ambiguity. -->
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-model'>
    <feature policy='disable' name='vmx'/>
    <feature policy='disable' name='svm'/>
  </cpu>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='kvmclock' present='yes'/>
  </clock>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native'
              discard='unmap' detect_zeroes='unmap' iothread='1'/>
      <source file='{{.DiskPath}}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
{{- if .CloudInitISO}}
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{.CloudInitISO}}'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
{{- end}}
    <interface type='network'>
      <mac address='{{.MACAddress}}'/>
      <source network='{{.Bridge}}'/>
      <!-- virtio-non-transitional = modern virtio 1.0 only; drops the legacy
           virtio config-plane the transitional device would otherwise expose to
           the guest driver. Requires libvirt >= 5.2. If you customize this
           template you MUST keep this model in sync with the update-device
           fragments in ApplyNWFilter/RemoveNWFilter (internal/virsh/virsh.go),
           or live nwfilter apply/remove fails. -->
      <model type='virtio-non-transitional'/>
      <driver name='vhost' queues='{{.NetQueues}}'/>
    </interface>
    <rng model='virtio-non-transitional'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <controller type='usb' model='none'/>
    <video><model type='none'/></video>
    <memballoon model='none'/>
{{- if .MonitorSocket}}
    <controller type='virtio-serial' index='0' model='virtio-non-transitional'/>
    <channel type='unix'>
      <source mode='bind' path='{{.MonitorSocket}}'>
        <permissions mode='0600' owner='{{.MonitorSocketUID}}' group='{{.MonitorSocketGID}}'/>
      </source>
      <target type='virtio' name='abox.monitor.0'/>
    </channel>
{{- end}}
  </devices>
  <qemu:commandline>
    <qemu:arg value='-sandbox'/>
    <qemu:arg value='on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny'/>
  </qemu:commandline>
</domain>
